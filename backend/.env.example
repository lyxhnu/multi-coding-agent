# ================================
# Multi-Coding Agent backend/.env
# ================================
#
# Minimum requirement to start the backend:
# 1. Configure one working chat model provider
# 2. Provide one valid API key for that provider
#
# Recommended minimum setup for this project:
#   LLM_PROVIDER=zhipu
#   LLM_MODEL=glm-5
#   LLM_API_KEY=your_zhipu_key
#
# Notes:
# - The backend reads backend/.env first, then falls back to system env vars.
# - For provider-specific keys, LLM_API_KEY or the provider-specific key can be used.
# - Embedding and mem0 are optional for startup, but recommended for better retrieval and long-term memory.


# ----------------
# Chat model (required)
# ----------------

# Supported providers: zhipu, bailian, deepseek, openai
LLM_PROVIDER=zhipu
LLM_MODEL=glm-5
LLM_API_KEY=
LLM_BASE_URL=


# ----------------
# Provider-specific aliases (optional)
# Keep only the section you actually use.
# ----------------

# Zhipu / BigModel
ZHIPU_API_KEY=
ZHIPUAI_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5

# Bailian / DashScope
BAILIAN_API_KEY=
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.5-plus

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1


# ----------------
# Embedding (optional)
# If omitted, backend can still start, but local MEMORY.md vector retrieval will be disabled.
# ----------------

# Supported providers: bailian, openai
EMBEDDING_PROVIDER=bailian
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=


# ----------------
# Web search (optional)
# ----------------

TAVILY_API_KEY=
TAVILY_PROJECT=


# ----------------
# Runtime tuning (optional)
# ----------------

MULTI_AGENT_TASK_TIMEOUT_SECONDS=600
TERMINAL_TIMEOUT_SECONDS=120


# ----------------
# mem0 long-term memory (optional)
# If not configured correctly, backend can still start.
# ----------------

# platform | oss
MEM0_PROVIDER=platform
MEM0_API_KEY=
MEM0_ORG_ID=
MEM0_PROJECT_ID=
MEM0_APP_ID=multi-coding-agent
MEM0_USER_ID=local-user
