# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# After installing requirements, also install Playwright browsers:
#   pip install -r requirements.txt
#   python -m playwright install chromium

# --- API Configuration ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
HARNESS_MODEL=

# --- Workspace ---
HARNESS_WORKSPACE=./workspace

# --- Harness Tuning (optional) ---
# MAX_HARNESS_ROUNDS=5
# PASS_THRESHOLD=7.0
# COMPRESS_THRESHOLD=80000
# RESET_THRESHOLD=150000
# MAX_AGENT_ITERATIONS=60
# Force the terminal agent to create _todo.md after this many tool calls.
# PROFILE_TERMINAL_TASK_TRACKING_NUDGE_AFTER=5
